[Unit]
Description=DMS virtual touchpad backend
Documentation=https://github.com/LilFishyChan/dms-vtpad-helper
After=graphical-session.target

[Service]
Type=simple
# %h 由 systemd 展开成用户 home，装在哪都不用改这个文件
ExecStart=%h/.local/bin/dms-vtpad-helper
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
